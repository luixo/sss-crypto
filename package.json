	},
	"dependencies": {
		"chalk": "^5.5.0",
		"cmd-ts": "^0.13.0",
		"ink": "^8.0.0",
		"react": "^19.3.1",
		"secrets.js": "git+https://git@github.com/grempe/secrets.js.git",
		"tsx": "^4.20.3",
		"zod": "^4.0.17"
	},
	"devDependencies": {
		"@luixo/configs": "0.1.0",
		"@standard-schema/spec": "^1.0.0",
		"@types/node": "^24.2.1",
		"@types/react": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.5",
		"ink-testing-library": "^4.0.0",
		"lint-staged": "^16.1.5",
		"memfs": "^4.36.0",
		"oxfmt": "0.73.0",
		"oxlint": "1.88.0",
		"oxlint-tsgolint": "7.0.2004",
		"pre-commit": "^1.2.2",
